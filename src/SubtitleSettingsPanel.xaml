<UserControl x:Class="LumenPlayer.SubtitleSettingsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LumenPlayer"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,3,5,6">
            <TextBlock Text="Sincronización" FontSize="16" FontWeight="SemiBold"/>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,8,0,16">
                <StackPanel>
                    <TextBlock x:Name="Timing" TextWrapping="Wrap"/>
                    <UniformGrid x:Name="TimingControls" Columns="3" Margin="0,9,0,0">
                        <Button Content="−100 ms" Margin="0,0,4,0" Click="OnAdvance" ToolTip="Adelantar subtítulos"
                                AutomationProperties.Name="Adelantar 100 milisegundos"/>
                        <Button Content="+100 ms" Margin="4,0" Click="OnDelay" ToolTip="Atrasar subtítulos"
                                AutomationProperties.Name="Atrasar 100 milisegundos"/>
                        <Button Content="Restablecer" Margin="4,0,0,0" Click="OnResetTiming"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <TextBlock Text="Apariencia y posición" FontSize="16" FontWeight="SemiBold"/>
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>
                <Label Content="Tamaño" Target="{Binding ElementName=TextSize}"/>
                <Slider x:Name="TextSize" Grid.Column="1" Minimum="16" Maximum="38" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="OnStyleSliderChanged" AutomationProperties.Name="Tamaño del texto"
                        ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0} px}"/>
                <TextBlock Grid.Row="1" Text="Color del texto" VerticalAlignment="Center" Margin="5,0"/>
                <UniformGrid Grid.Row="1" Grid.Column="1" Columns="4" VerticalAlignment="Center">
                    <RadioButton x:Name="White" GroupName="SubtitleColor" Content="Blanco" Tag="FFFFFF" Style="{StaticResource TabButton}" Checked="OnColorChanged"/>
                    <RadioButton x:Name="Yellow" GroupName="SubtitleColor" Content="Amarillo" Tag="FFE58A" Style="{StaticResource TabButton}" Checked="OnColorChanged"/>
                    <RadioButton x:Name="Blue" GroupName="SubtitleColor" Content="Celeste" Tag="ABDEFF" Style="{StaticResource TabButton}" Checked="OnColorChanged"/>
                    <RadioButton x:Name="Green" GroupName="SubtitleColor" Content="Verde" Tag="BDEBA6" Style="{StaticResource TabButton}" Checked="OnColorChanged"/>
                </UniformGrid>
                <Label Grid.Row="2" Content="Opacidad del texto" Target="{Binding ElementName=TextOpacity}"/>
                <Slider x:Name="TextOpacity" Grid.Row="2" Grid.Column="1" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="OnStyleSliderChanged" AutomationProperties.Name="Opacidad del texto"
                        ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0}%}"/>
                <Label Grid.Row="3" Content="Opacidad del fondo" Target="{Binding ElementName=BackgroundOpacity}"/>
                <Slider x:Name="BackgroundOpacity" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="OnStyleSliderChanged" AutomationProperties.Name="Opacidad del fondo"
                        ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0}%}"/>
                <Label Grid.Row="4" Content="Elevar subtítulos" Target="{Binding ElementName=VerticalOffset}"/>
                <Slider x:Name="VerticalOffset" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True"
                        ValueChanged="OnStyleSliderChanged" AutomationProperties.Name="Posición vertical desde abajo"
                        ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0} px}"/>
                <Label Grid.Row="5" Content="Grosor del borde" Target="{Binding ElementName=OutlineWidth}"/>
                <Slider x:Name="OutlineWidth" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="OnStyleSliderChanged" AutomationProperties.Name="Grosor del borde negro"
                        ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0} px}"/>
                <Label Grid.Row="6" Content="Opacidad de sombra" Target="{Binding ElementName=ShadowOpacity}"/>
                <Slider x:Name="ShadowOpacity" Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="OnStyleSliderChanged" AutomationProperties.Name="Opacidad de la sombra"
                        ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0}%}"/>
            </Grid>
            <Border Height="86" CornerRadius="10" Background="{StaticResource RaisedBrush}" Margin="0,8,0,8" ClipToBounds="True">
                <Border x:Name="SampleBackground" Padding="10,3" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <local:CaptionText x:Name="SampleText" Text="Vista previa" TextElement.FontFamily="{StaticResource UiFont}"/>
                </Border>
            </Border>
            <TextBlock x:Name="StyleNote" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,12,0,0">
                <Button x:Name="SaveDefaultButton" Content="Guardar como predeterminado" Click="OnSaveDefault"
                        ToolTip="Aplica este estilo a los videos que usan el predeterminado." Margin="0,0,8,4"/>
                <Button x:Name="UseDefaultButton" Content="Usar predeterminado" Click="OnUseDefault" Margin="0,0,0,4"
                        ToolTip="Este video seguirá el estilo predeterminado."/>
            </WrapPanel>
            <DockPanel LastChildFill="False" Margin="0,6,0,0">
                <Button DockPanel.Dock="Left" Content="Valores de fábrica" Click="OnResetAppearance"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
